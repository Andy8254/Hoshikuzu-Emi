# Copy this file to canary.env and fill it with the rotated canary token.
# canary.env is ignored by git.

BOT_ENV=canary
BOT_TOKEN=
BOT_DB_PATH=db/canary-master.db
BOT_USER_DB_PATH=db/canary-user.db
BOT_ENABLE_MISC_EXAMPLES=false
BOT_ENABLE_TETRIO_ROOM_AUTOMATION=false
TRIANGLE_BRIDGE_URL=http://127.0.0.1:8787

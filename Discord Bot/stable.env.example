# Copy this file to stable.env and fill it with the rotated stable token.
# stable.env is ignored by git.

BOT_ENV=stable
BOT_TOKEN=
BOT_DB_PATH=db/stable-master.db
BOT_USER_DB_PATH=db/stable-user.db
BOT_ENABLE_MISC_EXAMPLES=false
BOT_ENABLE_TETRIO_ROOM_AUTOMATION=false
TRIANGLE_BRIDGE_URL=http://127.0.0.1:8787
